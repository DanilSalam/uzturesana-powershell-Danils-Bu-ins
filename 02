# Atskaites ID: RVT-4417

$processi = Get-Process |
    Sort-Object -Property WorkingSet64 -Descending |
    Select-Object -First 10 |
    Sort-Object -Property WorkingSet64

foreach ($process in $processi) {
    $atmina = [math]::Round($process.WorkingSet64 / 1MB, 1)
    Write-Output "Nosaukums: $($process.ProcessName); ID: $($process.Id); Atmiņa: $atmina MB"
}
