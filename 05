# Atskaites ID: RVT-4417

$sakums = (Get-Date).AddHours(-48)

$kludas = @(
    Get-WinEvent -FilterHashtable @{
        LogName = "System"
        Level = 2
        StartTime = $sakums
    } -ErrorAction SilentlyContinue
)

Write-Output "Kļūdu skaits pēdējās 48 stundās: $($kludas.Count)"

if ($kludas.Count -gt 0) {
    $avots = $kludas |
        Group-Object -Property ProviderName |
        Sort-Object -Property Count -Descending |
        Select-Object -First 1

    Write-Output "Biežākais kļūdu avots: $($avots.Name)"
    Write-Output "Avota kļūdu skaits: $($avots.Count)"
}
else {
    Write-Output "Kļūdu avots: nav atrasts"
    Write-Output "Avota kļūdu skaits: 0"
}
